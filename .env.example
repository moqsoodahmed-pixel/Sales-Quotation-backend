PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/launcherdesk

# JWT - generate strong random values for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never reuse the same value for both secrets, and never commit real values.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRE=30d

# Allowed CORS origin(s) - comma separated, no trailing slashes.
# In production this MUST be the real deployed frontend origin(s) only.
# FRONTEND_URL is accepted as a fallback name for older configs.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Document storage (Phase 6)
DOCUMENT_STORAGE_DIR=uploads
MAX_DOCUMENT_SIZE_MB=10

# Required ONLY to run `npm run seed:reset` (destructive) when NODE_ENV=production.
# Leave unset in normal operation. The reset script refuses to run in production
# unless this exactly matches the confirmation token it prints.
# CONFIRM_PRODUCTION_RESET=
